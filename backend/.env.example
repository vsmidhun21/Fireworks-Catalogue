# Server Configuration
NODE_ENV=development
PORT=5000

# Database
# Default: SQLite in backend/data/app.db
# For production (MySQL): mysql://user:password@localhost:3306/sri_rr_crackers
DATABASE_URL=file:../data/app.db

# CORS Configuration
CORS_ORIGINS=http://localhost:5173

# Admin Authentication
ADMIN_JWT_SECRET=your-random-jwt-secret-key-at-least-32-chars
ADMIN_JWT_EXPIRES_IN=8h

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# Site URLs
PUBLIC_SITE_URL=http://localhost:5173
WHATSAPP_NUMBER=918754066248

# Admin Email Notification (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your-development-gmail@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
# Primary recipient (To field)
ADMIN_EMAIL=admin@example.com
# Optional: CC recipients (comma-separated, leave empty if not needed)
ADMIN_CC_EMAILS=
EMAIL_FROM_NAME=Sri RR Crackers
