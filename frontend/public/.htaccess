<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # If the request is for index.html itself, do not rewrite
  RewriteRule ^index\.html$ - [L]
  
  # If the requested resource exists as a file or directory, serve it directly
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  
  # Otherwise, redirect all requests to index.html for client-side routing (React Router)
  RewriteRule . /index.html [L]
</IfModule>

